<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/expense_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/expense_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#C2410C" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_action_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/recent_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#6C7B76" android:textSize="10sp" />
    <LinearLayout android:id="@+id/recent_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/recent_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="12sp" />
        <TextView android:id="@+id/recent_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
        <TextView android:id="@+id/recent_amount_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#C2410C" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recent_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/recent_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="12sp" />
        <TextView android:id="@+id/recent_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
        <TextView android:id="@+id/recent_amount_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#C2410C" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recent_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/recent_name_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="12sp" />
        <TextView android:id="@+id/recent_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
        <TextView android:id="@+id/recent_amount_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#C2410C" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#6C7B76" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>

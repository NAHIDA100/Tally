<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/income_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/income_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#15803D" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/expense_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/expense_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#C2410C" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_action"
            android:layout_width="wrap_content" android:layout_height="30dp"
            android:layout_gravity="bottom" android:gravity="center"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/widget_action_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/analysis_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#6C7B76" android:textSize="10sp" />
    <LinearLayout android:id="@+id/cat_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/cat_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="11sp" />
            <TextView android:id="@+id/cat_share_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/cat_amount_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#141F1C" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/cat_bar_1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:progressDrawable="@drawable/widget_progress_bar" android:max="1000" />
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/cat_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="11sp" />
            <TextView android:id="@+id/cat_share_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/cat_amount_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#141F1C" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/cat_bar_2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:progressDrawable="@drawable/widget_progress_bar" android:max="1000" />
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/cat_name_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="11sp" />
            <TextView android:id="@+id/cat_share_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/cat_amount_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#141F1C" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/cat_bar_3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:progressDrawable="@drawable/widget_progress_bar" android:max="1000" />
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/cat_name_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#141F1C" android:textSize="11sp" />
            <TextView android:id="@+id/cat_share_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#6C7B76" android:textSize="10sp" />
            <TextView android:id="@+id/cat_amount_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#141F1C" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar android:id="@+id/cat_bar_4" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="3dp" android:progressDrawable="@drawable/widget_progress_bar" android:max="1000" />
    </LinearLayout>
    <TextView android:id="@+id/analysis_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#6C7B76" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
